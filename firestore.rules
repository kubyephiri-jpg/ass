rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.token.email == "jeffchilus@gmail.com";
    }
    match /storeSettings/{id} {
      allow read: if true;
      allow write: if isOwner();
    }
    match /products/{id} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }
    match /orders/{id} {
      allow create: if request.resource.data.keys().hasAll(["customerName","whatsappNumber","items","total","status","createdAt"])
        && request.resource.data.keys().hasOnly(["customerName","whatsappNumber","deliveryDay","address","notes","items","total","status","createdAt","orderNumber"])
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 100
        && request.resource.data.whatsappNumber is string
        && request.resource.data.whatsappNumber.size() >= 9
        && request.resource.data.whatsappNumber.size() <= 15
        && request.resource.data.items is list
        && request.resource.data.items.size() >= 1
        && request.resource.data.items.size() <= 50
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.status == "new"
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isOwner();
    }
  }
}
